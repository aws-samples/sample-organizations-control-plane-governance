# Guard 2.x | Scope: AWS::Organizations::OrganizationalUnit | Params: none
# Description: OUs must not be nested more than 3 levels below the root.
# OU nesting must not exceed 3 levels below the root (inheritance becomes hard to reason about).
# Guard 2.x has no count(); depth is enforced with a regex on Path. "/" is written as \x2F.
#   Path example: o-xxxx/r-xxxx/ou-xxxx-aaaa/ou-xxxx-bbbb/
rule ou_depth_within_limit when resourceType == "AWS::Organizations::OrganizationalUnit" {
    configuration.Path == /^o-[a-z0-9]+\x2Fr-[a-z0-9]+(\x2Fou-[a-z0-9]+-[a-z0-9]+){1,3}\x2F$/
        <<OU is nested more than 3 levels below the root>>
}
